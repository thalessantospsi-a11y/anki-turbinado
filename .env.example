# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - ANKI TURBINADO
# ==============================================================================

# Credenciais públicas do Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=sua-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=seu-app-id

# Chave secreta da API do Google Gemini (NUNCA expor no frontend)
GEMINI_API_KEY=sua-gemini-api-key-aqui

# Credenciais de serviço Firebase Admin (Opcional para server-side tasks)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
