rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função auxiliar para verificar propriedade do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Regras para perfil de usuário
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Regras para Baralhos
    match /decks/{deckId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Regras para Flashcards
    match /cards/{cardId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Regras para Banco de Questões
    match /questions/{questionId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Regras para Logs de Revisão (Imutáveis após criação pelo usuário)
    match /reviews/{reviewId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow update, delete: if false; // Logs são imutáveis
    }

    // Regras para Tentativas de Questões
    match /attempts/{attemptId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Regras para Sessões de Estudo
    match /studySessions/{sessionId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // Regras para Histórico de Gerações da IA
    match /aiGenerations/{generationId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
